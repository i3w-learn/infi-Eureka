{
  "name": "infi-eureka-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate --envPath .env -j sql -m migrations/versions",
    "migrate:up": "npm run migrate -- up",
    "migrate:new": "npm run migrate -- create",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/db-reset.js",
    "migrate:test": "node-pg-migrate --envPath .env -d TEST_DATABASE_URL -j sql -m migrations/versions up",
    "migrate:status": "npm run migrate -- --dry-run up",
    "seed:reset": "node scripts/db-reset.js",
    "check:embeddable": "node scripts/check-embeddable.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fast-jwt": "^6.3.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.8.1",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
