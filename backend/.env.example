# Copy this file to `.env` and fill in real values. Never commit `.env`.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres. In production append ?sslmode=verify-full to force verified TLS.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eureka_dev
# Separate database used by integration tests — it gets wiped between runs.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/eureka_test

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Video storage. 'local' writes to disk; use 's3' in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Frontend origin allowed to call this API (comma-separated for more than one)
CORS_ORIGIN=http://localhost:5173

# Swagger UI at /docs (spec at /docs/json). Set to false to hide it.
DOCS_ENABLED=true

# Opens the fixed test account (9999999999 / 1234) on a deployment that would
# otherwise refuse it. Only for a demo with no real students — anyone who knows
# the number and code gets a free premium account.
DEMO_LOGIN=false

# Razorpay — from dashboard.razorpay.com (Phase 6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gupshup — sends the login code over WhatsApp. From the Gupshup dashboard; the
# template must be an authentication template approved by Meta. Leave these
# empty in development and the code comes back in the response as `devOtp`.
GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_APP_NAME=
GUPSHUP_TEMPLATE_ID=

# Enables POST /videos/upload (send the same value in the X-Admin-Key header).
# Leave empty to disable uploads — content then goes in through seeds only.
ADMIN_API_KEY=

# Requests per minute. Defaults match the SRS; raise only if you know why.
AUTH_RATE_LIMIT_MAX=5
PAYMENT_RATE_LIMIT_MAX=10
