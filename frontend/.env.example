# Base URL of the backend API. In development the Vite proxy handles /api/v1,
# so this can stay empty; a production build needs the real origin.
VITE_API_URL=/api/v1

# Google Analytics 4 measurement ID (Phase 7) — looks like G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=

# Razorpay public key (Phase 6). The secret key NEVER goes in the frontend.
VITE_RAZORPAY_KEY_ID=
